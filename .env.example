# Azure Entra External ID (CIAM)
# Estos valores los sacás del portal de Azure → tu tenant → App registrations
ENTRA_TENANT=<tu-tenant-subdomain>          # p.ej. contoso
ENTRA_TENANT_ID=<tu-tenant-id-guid>         # p.ej. xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ENTRA_CLIENT_ID=<client-id-de-la-api>       # el "audience" que va en el JWT

# CORS — lista separada por comas de orígenes permitidos
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Puerto del servidor (la spec pide 3001)
PORT=3001
